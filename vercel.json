{
  "name": "ea-lumina-app",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/cleanup-pending-payments",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/whatsapp-reminders",
      "schedule": "0 * * * *"
    }
  ]
}
